{
  "name": "@codelab/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "DATABASE_URL=${DATABASE_URL:-postgresql://codelab:codelab@localhost:5433/codelab_official?schema=public} tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "DATABASE_URL=${DATABASE_URL:-postgresql://codelab:codelab@localhost:5433/codelab_official?schema=public} node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "RUN_DATABASE_TESTS=1 DATABASE_URL=${DATABASE_URL:-postgresql://codelab:codelab@localhost:5433/codelab_official?schema=public} vitest run src/tests/prisma.integration.test.ts --maxWorkers=1",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://codelab:codelab@localhost:5433/codelab_official?schema=public} prisma generate --schema prisma/schema.prisma",
    "db:migrate": "DATABASE_URL=${DATABASE_URL:-postgresql://codelab:codelab@localhost:5433/codelab_official?schema=public} prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "DATABASE_URL=${DATABASE_URL:-postgresql://codelab:codelab@localhost:5433/codelab_official?schema=public} prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:status": "DATABASE_URL=${DATABASE_URL:-postgresql://codelab:codelab@localhost:5433/codelab_official?schema=public} prisma migrate status --schema prisma/schema.prisma",
    "db:seed": "DATABASE_URL=${DATABASE_URL:-postgresql://codelab:codelab@localhost:5433/codelab_official?schema=public} prisma db seed --schema prisma/schema.prisma",
    "db:studio": "DATABASE_URL=${DATABASE_URL:-postgresql://codelab:codelab@localhost:5433/codelab_official?schema=public} prisma studio --schema prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
