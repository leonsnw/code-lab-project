generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionLanguage {
  JAVASCRIPT
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  RUNTIME_ERROR
  TIMEOUT
}

enum ExecutionStatus {
  COMPLETED
  RUNTIME_ERROR
  TIMEOUT
}

model User {
  id          String       @id
  name        String
  email       String       @unique
  passwordHash String      @map("password_hash")
  role        UserRole     @default(STUDENT)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  challenges  Challenge[]  @relation("ChallengeCreator")
  comments    Comment[]
  ratings     Rating[]
  score       Score?
  submissions Submission[]

  @@map("users")
}

model Challenge {
  id          String       @id
  title       String
  slug        String       @unique
  description String
  difficulty  Difficulty
  points      Int
  constraints String[]
  examples    Json
  isActive    Boolean      @default(true) @map("is_active")
  createdBy   String       @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  creator     User         @relation("ChallengeCreator", fields: [createdBy], references: [id])
  comments    Comment[]
  ratings     Rating[]
  submissions Submission[]
  tags        ChallengeTag[]
  testCases   TestCase[]

  @@index([difficulty])
  @@index([isActive])
  @@map("challenges")
}

model TestCase {
  id             String    @id
  challengeId    String    @map("challenge_id")
  input          String
  expectedOutput String    @map("expected_output")
  isPublic       Boolean   @default(false) @map("is_public")
  weight         Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  challenge      Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@map("test_cases")
}

model Submission {
  id           String                @id
  userId       String                @map("user_id")
  challengeId  String                @map("challenge_id")
  language     SubmissionLanguage
  sourceCode   String                @map("source_code")
  status       SubmissionStatus
  scoreAwarded Int                   @default(0) @map("score_awarded")
  submittedAt  DateTime              @map("submitted_at")
  evaluatedAt  DateTime?             @map("evaluated_at")

  challenge    Challenge             @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  testResults  SubmissionTestResult[]

  @@index([userId])
  @@index([challengeId])
  @@index([status])
  @@index([submittedAt])
  @@map("submissions")
}

model SubmissionTestResult {
  id              String          @id
  submissionId    String          @map("submission_id")
  testCaseId      String          @map("test_case_id")
  executionStatus ExecutionStatus @map("execution_status")
  isPublic        Boolean         @map("is_public")
  passed          Boolean
  input           String
  expectedOutput  String          @map("expected_output")
  actualOutput    String          @map("actual_output")
  error           String?
  durationMs      Int             @map("duration_ms")

  submission      Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_test_results")
}

model Score {
  id          String   @id
  userId      String   @unique @map("user_id")
  totalPoints Int      @default(0) @map("total_points")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("scores")
}

model Comment {
  id          String    @id
  userId      String    @map("user_id")
  challengeId String    @map("challenge_id")
  content     String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([userId])
  @@map("comments")
}

model Rating {
  id          String    @id
  userId      String    @map("user_id")
  challengeId String    @map("challenge_id")
  value       Int
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([challengeId])
  @@map("ratings")
}

model Tag {
  id         String         @id
  name       String         @unique
  slug       String         @unique
  challenges ChallengeTag[]

  @@map("tags")
}

model ChallengeTag {
  challengeId String    @map("challenge_id")
  tagId       String    @map("tag_id")

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([challengeId, tagId])
  @@map("challenge_tags")
}
