{
  "name": "code-lab-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "CodeLab: plataforma de desafios de programacao.",
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "build": "npm run build -w apps/api",
    "test": "npm run test -w apps/api",
    "test:coverage": "npm run test:coverage -w apps/api",
    "test:integration": "npm run test:integration -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w apps/api",
    "db:migrate:status": "npm run db:migrate:status -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "start": "npm run start -w apps/api"
  }
}
