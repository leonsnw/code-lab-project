{
  "name": "code-lab-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "CodeLab: plataforma de desafios, avaliacao por casos de teste e pontuacao.",
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run css:build && (npm run css:watch & npm run dev -w apps/api)",
    "css:build": "tailwindcss -i apps/web/styles/app.css -o apps/web/public/styles.css --minify",
    "css:watch": "tailwindcss -i apps/web/styles/app.css -o apps/web/public/styles.css --watch",
    "build": "npm run css:build && npm run build -w apps/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write",
    "format:check": "prettier --check \"apps/api/**/*.ts\" \"apps/web/public/js/**/*.js\" \"scripts/**/*.mjs\" \"scripts/**/*.mts\" \"*.mjs\"",
    "db:generate": "npm run db:generate -w apps/api",
    "db:push": "npm run db:push -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w apps/api",
    "db:migrate:status": "npm run db:migrate:status -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "test": "npm run test -w apps/api",
    "test:coverage": "npm run test:coverage -w apps/api",
    "test:integration": "npm run test:integration -w apps/api",
    "start": "npm run start -w apps/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.72.1"
  }
}
